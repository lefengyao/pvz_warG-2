# Keep text files stable across platforms: LF in both repository and worktree.
* text=auto eol=lf

# Binary game assets must never be converted or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text eol=lf
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary

# Godot sidecars stay tracked as plain text next to their resources.
*.import text eol=lf
*.uid text eol=lf
